<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- Keys (UIManager.openKeys), opened from a row in Settings: one row per action, made from SettingRow.uxml by the code.
         Back (or Esc, or B on a controller) returns to Settings. -->
    <El class="pause saves settings">
        <El class="intro-card settings-card keys-card">
            <El tag="h1" text="Keyboard keys" />
            <El name="rows" class="set-rows" />
            <El tag="button" name="back" class="btn" text="Back" />
        </El>
    </El>
</ui:UXML>
