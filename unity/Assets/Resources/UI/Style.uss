/* ==========================================================================
   The game's UI: menus, cards and the HUD (UI Toolkit, USS)
   ==========================================================================

   The UI began as a port of the browser game's style.css, and the DOM layer in Assets/Scripts/Dom still builds it from
   HTML-like elements, but the look is the game's own now.

   1. THE PAGE. Everything is laid out on a 1920 x 1080 page that DomHost scales to the screen (a wider or taller screen
      sees more page). Sizes here are in those page pixels, so the UI takes up the same share of a 720p window and a 4K TV.

   2. THE SKIN. Panels, buttons, key caps, controller buttons, meters and frames are pictures in Resources/UI/Skin, drawn by
      unity/Tools/UiSkin/make_skin.py at twice their shown size and stretched as 9-slices. The cut lines
      (-unity-slice-*) are in picture pixels; -unity-slice-scale: 0.5px brings the uncut corners back to page pixels.
      A button's picture keeps a margin of 4 px (3 for small ones) free all round, which the focus ring is drawn in.

   3. ONE HIGHLIGHT. The mouse, the keyboard and a controller all move the same focus (HTMLElement.HoverFocus,
      Game.padNav), so buttons are styled for :focus and not for :hover.

   4. WHAT USS LACKS, and where it is made up for:
      - z-index: sibling order, from CssAnimations.ZIndex
           #boot 100, .padbar 50, .map-cursor 20, .achievements 7, .helpscreen 7, .farewell 6, .credits 6, .bookview 6,
           .teaser 6, .pause.saves 5, .sleepveil 3
      - pointer-events: none: CssAnimations.PointerEventsNone
           #ui, .gone, .prompt, .hud, .result, .fade, .binoc, .map-cursor, .padtools, .padbar, .sleepveil, .dive-tint
      - overflow-y: auto: a ScrollView, for .camp-body, .save-list, .ach-list, .help-body, .set-rows
      - tag selectors: .t-<tag>; :disabled: .disabled; :checked: .checked
      - .note:nth-child(even): .note.even; .pt-center i:nth-child(n): .t-i.nth-n; ::before / ::after: real elements
      - text-transform: uppercase: HTMLElement.UPPERCASE
      - @keyframes: CssAnimations.cs
   ========================================================================== */

:root {
  --ink: #2a1c14;
  --paper: #fbf2de;
  --paper-in: #f1e4c6;
  --coral: #ea6a47;
  --teal: #2f968a;
  --gold: #ffc84a;
}

.t-html,
.t-body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  /* the UI is drawn over Unity's camera, so the page itself stays clear */
  background-color: rgba(0, 0, 0, 0);
  color: #2a1c14;
  font-size: 18px;
  white-space: normal;
}

/* An element's text is drawn by a Unity Label inside it, and Unity's default theme gives labels a white-space of their own,
   which beats the white-space they would inherit from the page: every paragraph ran on as one long line out of its box.
   Text wraps again here; the page's nowrap rules repeat themselves for labels at the end of this file. */
.t-html .unity-label {
  white-space: normal;
}

.t-div,
.t-p,
.t-span,
.t-li,
.t-label {
  white-space: normal;
}

/* h1 and h2 are drawn in the heading face (DomHost.DisplayFont), which is already bold */
.t-h1 {
  -unity-font-style: normal;
  font-size: 34px;
  margin: 0 0 8px 0;
  white-space: normal;
}

.t-h2 {
  -unity-font-style: normal;
  font-size: 26px;
  margin: 0 0 8px 0;
  white-space: normal;
}

.t-h3 {
  -unity-font-style: bold;
  font-size: 20px;
  margin: 12px 0 6px 0;
  white-space: normal;
}

.t-h4 {
  -unity-font-style: bold;
  font-size: 18px;
  margin: 8px 0 6px 0;
  white-space: normal;
}

.t-p {
  margin: 0 0 10px 0;
}

.t-b {
  -unity-font-style: bold;
}

.t-em {
  -unity-font-style: italic;
}

.t-small {
  font-size: 13px;
}

.t-ul {
  margin: 0;
  padding: 0;
}

.t-button {
  border-width: 0;
  margin: 0;
  background-color: rgba(0, 0, 0, 0);
}

.hidden {
  display: none;
}

/* ---------- loading screen ---------- */
#boot {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #2b6f78;
  color: #fff3d6;
  opacity: 1;
  transition-property: opacity;
  transition-duration: 0.5s;
}

#boot.gone {
  opacity: 0;
}

#boot .t-h1 {
  margin: 0 0 14px 0;
  font-size: 68px;
  -unity-text-align: middle-center;
  text-shadow: 0 5px 0 #2a1c14;
  -unity-text-outline-width: 1px;
  -unity-text-outline-color: #2a1c14;
}

#boot .t-p {
  margin: 0 0 26px 0;
  font-size: 22px;
  -unity-font-style: italic;
  opacity: 0.9;
  -unity-text-align: middle-center;
}

#boot-track {
  width: 380px;
  height: 24px;
  padding: 3px;
  background-image: resource("UI/Skin/bar");
  -unity-slice-left: 24;
  -unity-slice-right: 24;
  -unity-slice-scale: 0.5px;
}

#boot-bar {
  width: 0;
  height: 18px;
  background-image: resource("UI/Skin/bar-fill");
  -unity-slice-left: 18;
  -unity-slice-right: 18;
  -unity-slice-scale: 0.5px;
  transition-property: width;
  transition-duration: 0.3s;
}

/* ---------- scene & root ---------- */
#scene {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  display: flex;
}

#ui {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* ---------- keys and controller buttons (UI/Glyphs.cs) ---------- */
.kc {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 32px;
  min-width: 32px;
  margin: 0 6px 0 0;
  font-size: 16px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  white-space: nowrap;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.kc.key {
  padding: 0 9px 4px 9px;
  color: #2a1c14;
  background-image: resource("UI/Skin/key");
  -unity-slice-left: 24;
  -unity-slice-top: 24;
  -unity-slice-right: 24;
  -unity-slice-bottom: 30;
  -unity-slice-scale: 0.5px;
}

.kc.pad-cap {
  padding: 0 8px 4px 8px;
  font-size: 14px;
  color: #fbf2de;
  background-image: resource("UI/Skin/key-dark");
  -unity-slice-left: 24;
  -unity-slice-top: 24;
  -unity-slice-right: 24;
  -unity-slice-bottom: 30;
  -unity-slice-scale: 0.5px;
}

.kc.pad-a,
.kc.pad-b,
.kc.pad-x,
.kc.pad-y,
.kc.pad-stick,
.kc.pad-dpad {
  width: 32px;
  padding: 0 0 2px 0;
  color: #ffffff;
  text-shadow: 0 1px 0 rgba(20, 12, 8, 0.55);
}

.kc.pad-a {
  background-image: resource("UI/Skin/pad-a");
}

.kc.pad-b {
  background-image: resource("UI/Skin/pad-b");
}

.kc.pad-x {
  background-image: resource("UI/Skin/pad-x");
}

.kc.pad-y {
  background-image: resource("UI/Skin/pad-y");
  color: #2a1c14;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.kc.pad-stick {
  padding: 0;
  font-size: 12px;
  color: #fbf2de;
  background-image: resource("UI/Skin/pad-stick");
}

.kc.pad-dpad {
  background-image: resource("UI/Skin/pad-dpad");
}

.kc.pad-dpad.d-up {
  background-image: resource("UI/Skin/pad-dpad-up");
}

.kc.pad-dpad.d-down {
  background-image: resource("UI/Skin/pad-dpad-down");
}

.kc.pad-dpad.d-left {
  background-image: resource("UI/Skin/pad-dpad-left");
}

.kc.pad-dpad.d-right {
  background-image: resource("UI/Skin/pad-dpad-right");
}

.kc.mouse-l,
.kc.mouse-r,
.kc.mouse-m {
  width: 25px;
  min-width: 25px;
  height: 32px;
}

.kc.mouse-l {
  background-image: resource("UI/Skin/mouse-l");
}

.kc.mouse-r {
  background-image: resource("UI/Skin/mouse-r");
}

.kc.mouse-m {
  background-image: resource("UI/Skin/mouse-m");
}

/* ---------- crosshair & prompts ---------- */
.cross {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 12px;
  height: 12px;
  margin: -6px 0 0 -6px;
  border-radius: 50%;
  border-width: 2px;
  border-color: rgba(255, 255, 255, 0.9);
  background-color: rgba(42, 28, 20, 0.25);
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
}

.cross.on {
  opacity: 1;
}

/* a row as wide as the screen with the prompt in its middle (see UIManager: centred) */
.prompt-row {
  position: absolute;
  left: 0;
  right: 0;
  top: 60%;
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.prompt-row.p2 {
  top: 66%;
}

.prompt {
  translate: 0 8px;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 9px 22px 9px 12px;
  background-image: resource("UI/Skin/plate-gold");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #fff6e4;
  font-size: 21px;
  -unity-font-style: bold;
  opacity: 0;
  transition-property: opacity, translate;
  transition-duration: 0.18s, 0.18s;
  white-space: nowrap;
}

.prompt.on {
  opacity: 1;
  translate: 0 0;
}

/* looking through the camera: the prompts fade out of the photo's way (UIManager.setViewfinder) */
.viewfinder .prompt.on {
  opacity: 0;
}

/* the key bobs gently (CssAnimations: .kbd) */
.prompt .kbd {
  margin-right: 12px;
}

.prompt .kbd .kc {
  margin: 0;
}

.drawbar {
  position: absolute;
  left: 50%;
  top: 54%;
  width: 120px;
  height: 10px;
  margin-left: -60px;
  border-radius: 5px;
  background-color: rgba(42, 28, 20, 0.6);
  border-width: 2px;
  border-color: #2a1c14;
  overflow: hidden;
}

.drawbar .fill {
  height: 100%;
  width: 0;
  background-color: #ffc84a;
  transition-property: none;
  transition-duration: 0s;
}

/* ---------- HUD ---------- */
.hud {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

/* coins and warmth, top left */
.stats {
  position: absolute;
  top: 26px;
  left: 28px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 8px;
  padding: 7px 18px 7px 10px;
  color: #fbf2de;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.stat .ico {
  width: 36px;
  margin-right: 8px;
  font-size: 26px;
  -unity-text-align: middle-center;
}

.stat.coins .val {
  font-size: 27px;
  color: #ffd76a;
  text-shadow: 0 2px 0 rgba(20, 12, 8, 0.6);
}

.warm-col {
  display: flex;
  flex-direction: column;
  width: 240px;
}

.warm-head {
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 4px;
}

.warm-head .sub {
  font-size: 14px;
  opacity: 0.82;
}

.warm-head .val {
  font-size: 16px;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.row > * {
  margin-right: 8px;
}

.row.between {
  justify-content: space-between;
}

.row.gap {
  justify-content: center;
  margin-top: 10px;
}

.row.gap > * {
  margin-left: 4px;
  margin-right: 4px;
}

.ico {
  font-size: 22px;
}

.val {
  -unity-font-style: bold;
  font-size: 18px;
}

.sub {
  font-size: 14px;
  opacity: 0.75;
}

/* meters: the track is 24 px tall and the fill sits inside its 3 px edge */
.bar {
  height: 24px;
  padding: 3px;
  background-image: resource("UI/Skin/bar");
  -unity-slice-left: 24;
  -unity-slice-right: 24;
  -unity-slice-scale: 0.5px;
}

.bar.big {
  margin-top: 10px;
}

.bar .fill {
  height: 18px;
  width: 100%;
  background-image: resource("UI/Skin/bar-fill");
  -unity-slice-left: 18;
  -unity-slice-right: 18;
  -unity-slice-scale: 0.5px;
  transition-property: width;
  transition-duration: 0.25s;
  transition-timing-function: ease;
}

.bar .fill.low {
  background-image: resource("UI/Skin/bar-fill-cold");
}

.bar .fill.teal {
  background-image: resource("UI/Skin/bar-fill-teal");
}

/* day, backpack, ecology, bones and sound, top right */
.right-chips {
  position: absolute;
  top: 26px;
  right: 28px;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.right-chips > * {
  margin-left: 8px;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 8px 16px;
  border-width: 0;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  -unity-font-style: bold;
  font-size: 19px;
  color: #fbf2de;
  white-space: nowrap;
}

.chip .val {
  font-size: 19px;
}

/* the detector's screen, bottom left */
.scope {
  position: absolute;
  left: 28px;
  bottom: 28px;
  padding: 9px 10px 10px 10px;
  border-radius: 14px;
  background-color: #1c1f1d;
  border-width: 3px;
  border-color: #2a1c14;
}

.scope.dim {
  opacity: 0.35;
}

.scope-title {
  font-size: 11px;
  -unity-font-style: bold;
  color: #8fe0a8;
  letter-spacing: 3px;
  margin-bottom: 5px;
}

.wave {
  display: flex;
  border-radius: 6px;
}

/* what the keys do right now, bottom centre */
.hint-row {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 30px;
  display: flex;
  flex-direction: row;
  justify-content: center;
}

.hint {
  display: flex;
  flex-direction: row;
  /* a long line (swimming has eight keys) wraps onto a second row before it reaches the tool in the bottom right corner
     or the detector's screen in the bottom left */
  flex-wrap: wrap;
  justify-content: center;
  max-width: 1240px;
  align-items: center;
  padding: 7px 12px;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #fbf2de;
  font-size: 17px;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.2s;
  white-space: nowrap;
}

.hint.show {
  opacity: 1;
}

.hint-seg {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 32px;
  margin: 0 10px;
}

.hint-seg .t-span {
  white-space: nowrap;
}

.hint-seg .kc {
  margin: 0 7px 0 0;
}

/* a key in the middle of a sentence ("Hold [RT] to draw") */
.hint-seg .kc.mid {
  margin-left: 7px;
}

.toasts {
  position: absolute;
  top: 104px;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.toast {
  padding: 12px 26px;
  margin-bottom: 8px;
  background-image: resource("UI/Skin/plate-paper");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #2a1c14;
  font-size: 19px;
  -unity-font-style: bold;
  opacity: 0;
  translate: 0 -14px;
  transition-property: opacity, translate;
  transition-duration: 0.35s, 0.35s;
  transition-timing-function: ease, ease;
  max-width: 720px;
  -unity-text-align: middle-center;
}

.toast.in {
  opacity: 1;
  translate: 0 0;
}

/* the tool in hand, bottom right (keyboard and mouse) */
.tool-badge {
  position: absolute;
  right: 28px;
  bottom: 28px;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 9px 20px 9px 14px;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #fbf2de;
  -unity-font-style: bold;
  font-size: 20px;
}

.tool-badge .tb-ico {
  font-size: 27px;
  margin-right: 10px;
}

/* the mini-map and the frame round it */
.minimap {
  position: absolute;
  right: 38px;
  bottom: 106px;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background-color: rgba(13, 27, 38, 0.4);
}

.minimap-ring {
  position: absolute;
  right: 28px;
  bottom: 90px;
  width: 170px;
  height: 176px;
  background-image: resource("UI/Skin/minimap-ring");
}

/* ---------- controller tool picker (d-pad) ---------- */
.padtools {
  position: absolute;
  right: 30px;
  bottom: 26px;
  width: 164px;
  height: 196px;
}

.padtools.hidden {
  display: none;
}

.pt {
  position: absolute;
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  -unity-text-align: middle-center;
  font-size: 25px;
  color: #fbf2de;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  opacity: 0.85;
  transition-property: scale, opacity;
  transition-duration: 0.15s, 0.15s;
}

.pt.up {
  left: 56px;
  top: 0;
}

.pt.left {
  left: 0;
  top: 56px;
}

.pt.right {
  left: 112px;
  top: 56px;
}

.pt.down {
  left: 56px;
  top: 112px;
}

.pt.on {
  opacity: 1;
  scale: 1.12 1.12;
  background-image: resource("UI/Skin/plate-gold");
}

.pt.empty {
  opacity: 0.35;
}

.pt .t-small {
  position: absolute;
  right: 5px;
  bottom: 2px;
  font-size: 12px;
  -unity-font-style: bold;
  color: #ffd76a;
}

.pt .t-em {
  position: absolute;
  left: 5px;
  top: 1px;
  font-size: 12px;
  -unity-font-style: normal;
  color: #ffd76a;
}

.pt-center {
  position: absolute;
  left: 61px;
  top: 61px;
  width: 42px;
  height: 42px;
  background-image: resource("UI/Skin/pad-dpad");
  opacity: 0.9;
}

.pt-center .t-i {
  display: none;
}

.pt-caption {
  position: absolute;
  left: 0;
  right: 0;
  top: 170px;
  -unity-text-align: middle-center;
  -unity-font-style: bold;
  font-size: 17px;
  color: #fff6e4;
  text-shadow: 0 2px 0 rgba(20, 12, 8, 0.75);
}

/* the d-pad picker is taller than the badge, so the mini-map moves up above it */
.t-body.usingpad .minimap,
.usingpad .minimap {
  bottom: 256px;
}

.t-body.usingpad .minimap-ring,
.usingpad .minimap-ring {
  bottom: 240px;
}

/* ---------- buttons ---------- */
.btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-height: 54px;
  padding: 9px 26px 15px 26px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
  background-image: resource("UI/Skin/btn");
  -unity-slice-left: 44;
  -unity-slice-top: 44;
  -unity-slice-right: 44;
  -unity-slice-bottom: 54;
  -unity-slice-scale: 0.5px;
  color: #ffffff;
  font-size: 20px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  text-shadow: 0 2px 0 rgba(120, 40, 24, 0.7);
  white-space: nowrap;
  transition-property: translate, scale;
  transition-duration: 0.08s, 0.1s;
}

.btn:focus {
  background-image: resource("UI/Skin/btn-focus");
  scale: 1.03 1.03;
}

.btn:active {
  background-image: resource("UI/Skin/btn-down");
  translate: 0 1px;
}

.btn.ghost {
  background-image: resource("UI/Skin/btn-ghost");
  color: #2a1c14;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.btn.ghost:focus {
  background-image: resource("UI/Skin/btn-ghost-focus");
}

.btn.ghost:active {
  background-image: resource("UI/Skin/btn-ghost-focus");
  translate: 0 2px;
}

.btn.big {
  min-height: 62px;
  padding: 11px 34px 17px 34px;
  font-size: 23px;
}

.btn.small {
  min-height: 40px;
  padding: 5px 16px 9px 16px;
  font-size: 16px;
  background-image: resource("UI/Skin/btn-sm");
  -unity-slice-left: 30;
  -unity-slice-top: 30;
  -unity-slice-right: 30;
  -unity-slice-bottom: 36;
}

.btn.small:focus {
  background-image: resource("UI/Skin/btn-sm-focus");
}

.btn.small:active {
  background-image: resource("UI/Skin/btn-sm-focus");
  translate: 0 2px;
}

.btn.small.ghost {
  background-image: resource("UI/Skin/btn-sm-ghost");
}

.btn.small.ghost:focus,
.btn.small.ghost:active {
  background-image: resource("UI/Skin/btn-sm-ghost-focus");
}

/* a button with a key drawn in it ("[Space] Add to Backpack") */
.btn .kc {
  margin: 0 10px 0 -6px;
}

/* tabs: the page showing is teal */
.btn.tab {
  min-height: 40px;
  padding: 5px 13px 9px 13px;
  font-size: 15px;
  color: #2a1c14;
  text-shadow: 0 0 0 rgba(0, 0, 0, 0);
  background-image: resource("UI/Skin/btn-sm-ghost");
  -unity-slice-left: 30;
  -unity-slice-top: 30;
  -unity-slice-right: 30;
  -unity-slice-bottom: 36;
}

.btn.tab:focus,
.btn.tab:active {
  background-image: resource("UI/Skin/btn-sm-ghost-focus");
}

.btn.tab.on {
  color: #ffffff;
  text-shadow: 0 2px 0 rgba(20, 70, 64, 0.8);
  background-image: resource("UI/Skin/btn-sm-teal");
}

.btn.tab.on:focus,
.btn.tab.on:active {
  background-image: resource("UI/Skin/btn-sm-teal-focus");
}

.btn.disabled,
.btn.disabled:focus,
.btn.disabled:active {
  opacity: 0.4;
  translate: 0 0;
  scale: 1 1;
}

/* ---------- cleaning a find ---------- */
.inspect {
  position: absolute;
  left: 50%;
  bottom: 22px;
  translate: -50% 0;
  width: 560px;
  max-width: 92%;
  padding: 18px 28px 30px 28px;
  background-image: resource("UI/Skin/panel");
  -unity-slice-left: 68;
  -unity-slice-top: 68;
  -unity-slice-right: 68;
  -unity-slice-bottom: 92;
  -unity-slice-scale: 0.5px;
}

.inspect-title {
  -unity-font-style: bold;
  font-size: 23px;
  -unity-text-align: middle-center;
}

.inspect-help {
  font-size: 15px;
  opacity: 0.72;
  -unity-text-align: middle-center;
  margin-top: 2px;
}

.inspect .row.between {
  margin-top: 4px;
}

.result {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: center;
  padding-top: 64px;
  background-color: rgba(16, 24, 34, 0.34);
}

/* the card for a cleaned find (it pops in: CssAnimations .card) */
.card {
  width: 460px;
  max-width: 90%;
  padding: 0 32px 34px 32px;
  background-image: resource("UI/Skin/panel");
  -unity-slice-left: 68;
  -unity-slice-top: 68;
  -unity-slice-right: 68;
  -unity-slice-bottom: 92;
  -unity-slice-scale: 0.5px;
  -unity-text-align: middle-center;
  align-items: center;
}

.card .cat {
  margin: -18px 0 12px 0;
  padding: 7px 24px 13px 24px;
  background-image: resource("UI/Skin/title-coral");
  -unity-slice-left: 40;
  -unity-slice-top: 40;
  -unity-slice-right: 40;
  -unity-slice-bottom: 48;
  -unity-slice-scale: 0.5px;
  color: #fff8e8;
  font-size: 14px;
  -unity-font-style: bold;
  letter-spacing: 3px;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.card .t-h2 {
  margin: 2px 0 8px 0;
  font-size: 30px;
  -unity-text-align: middle-center;
}

.card .lore {
  -unity-font-style: italic;
  font-size: 18px;
  opacity: 0.86;
  margin: 0 0 14px 0;
  -unity-text-align: middle-center;
}

.card .worth {
  -unity-font-style: bold;
  font-size: 24px;
  color: #b03e28;
  margin-bottom: 16px;
  -unity-text-align: middle-center;
}

.fade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #10161e;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.3s;
  transition-timing-function: ease;
}

.fade.on {
  opacity: 1;
}

/* the opening: one line of story at a time along the bottom, and a word on how to skip it */
.cine-caption {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 11%;
  align-items: center;
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.6s;
  transition-timing-function: ease;
}

.cine-caption.in {
  opacity: 1;
}

.cine-caption-text {
  max-width: 980px;
  padding: 14px 36px;
  background-color: rgba(10, 14, 20, 0.6);
  border-radius: 16px;
  color: #fdf6e3;
  font-size: 28px;
  -unity-text-align: middle-center;
  white-space: normal;
}

/* lightning: the whole screen whitens for an instant */
.cine-flash {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: #e6efff;
  opacity: 0;
}

.cine-skip {
  position: absolute;
  right: 30px;
  top: 24px;
  padding: 6px 16px;
  background-color: rgba(10, 14, 20, 0.45);
  border-radius: 12px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 16px;
}

/* ---------- cards: the pause screen, settings, saves, help and the rest ---------- */
.intro,
.pause {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background-color: rgba(16, 24, 34, 0.66);
}

.intro {
  transition-property: opacity;
  transition-duration: 0.6s;
}

.intro.gone {
  opacity: 0;
}

.intro-card {
  width: 600px;
  max-width: 92%;
  padding: 0 36px 38px 36px;
  background-image: resource("UI/Skin/panel");
  -unity-slice-left: 68;
  -unity-slice-top: 68;
  -unity-slice-right: 68;
  -unity-slice-bottom: 92;
  -unity-slice-scale: 0.5px;
  -unity-text-align: middle-center;
}

/* a tall card keeps its heading, notes and buttons at full height; the list inside it is what gives way and scrolls */
.intro-card > * {
  flex-shrink: 0;
}

.intro-card > .btn {
  align-self: center;
}

/* a card's heading is a teal plate that sits on its top edge */
.intro-card > .t-h1 {
  align-self: center;
  margin: -22px 0 14px 0;
  padding: 8px 40px 15px 40px;
  background-image: resource("UI/Skin/title");
  -unity-slice-left: 40;
  -unity-slice-top: 40;
  -unity-slice-right: 40;
  -unity-slice-bottom: 48;
  -unity-slice-scale: 0.5px;
  color: #fff8e8;
  font-size: 32px;
  text-shadow: 0 2px 0 rgba(20, 70, 64, 0.85);
  -unity-text-align: middle-center;
  white-space: nowrap;
}

.intro-card .tag {
  margin: 0 0 14px 0;
  font-size: 18px;
  opacity: 0.78;
  -unity-font-style: italic;
  -unity-text-align: middle-center;
}

.intro-card .t-ul {
  -unity-text-align: middle-left;
  padding: 0;
  margin: 0 0 18px 0;
}

/* lists of keys in Help */
.keys {
  display: flex;
  flex-direction: column;
  margin: 0 0 16px 0;
  -unity-text-align: middle-left;
}

.krow {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 6px;
}

.krow .t-b {
  width: 150px;
  flex-shrink: 0;
  margin: 0 16px 0 0;
  padding: 5px 8px 9px 8px;
  font-size: 15px;
  color: #2a1c14;
  -unity-text-align: middle-center;
  white-space: nowrap;
  background-image: resource("UI/Skin/key");
  -unity-slice-left: 24;
  -unity-slice-top: 24;
  -unity-slice-right: 24;
  -unity-slice-bottom: 30;
  -unity-slice-scale: 0.5px;
}

.krow .t-span {
  flex-grow: 1;
  flex-shrink: 1;
  font-size: 17px;
  -unity-text-align: middle-left;
}

/* the pause screen: one column of buttons */
.pause-card {
  width: 460px;
}

.pause-actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.pause-actions > .btn {
  margin-bottom: 2px;
}

.pause-actions .row.gap {
  margin-top: 0;
}

.confirm-q {
  margin: 6px 0 14px 0;
  font-size: 19px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
}

.save-info {
  margin: 10px 0 0 0;
  font-size: 15px;
  opacity: 0.65;
  -unity-text-align: middle-center;
}

/* ---------- camp ---------- */
.camp {
  position: absolute;
  top: 20px;
  right: 20px;
  bottom: 20px;
  width: 600px;
  max-width: 94%;
  display: flex;
  flex-direction: column;
  padding: 4px 4px 17px 4px;
  background-image: resource("UI/Skin/panel");
  -unity-slice-left: 68;
  -unity-slice-top: 68;
  -unity-slice-right: 68;
  -unity-slice-bottom: 92;
  -unity-slice-scale: 0.5px;
}

.camp-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px 6px 20px;
}

.camp-head .t-h2 {
  margin: 0;
  padding: 6px 24px 12px 24px;
  background-image: resource("UI/Skin/title");
  -unity-slice-left: 40;
  -unity-slice-top: 40;
  -unity-slice-right: 40;
  -unity-slice-bottom: 48;
  -unity-slice-scale: 0.5px;
  color: #fff8e8;
  font-size: 25px;
  text-shadow: 0 2px 0 rgba(20, 70, 64, 0.85);
  white-space: nowrap;
}

.tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 6px 8px 8px 8px;
  border-bottom-width: 3px;
  border-bottom-color: rgba(42, 28, 20, 0.14);
}

/* the tabs themselves, wrapping between the two keys that turn the pages */
.tabs-wrap {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  flex-grow: 1;
  flex-shrink: 1;
}

.tabs-wrap > * {
  margin: 0;
}

.tabs > .kc,
.help-tabs > .kc {
  margin: 0 6px 4px 6px;
}

/* the camp has many pages and a narrow panel */
.tabs .btn.tab {
  padding-left: 10px;
  padding-right: 10px;
}

.tabs .tabs-wrap {
  justify-content: center;
}

.camp-body {
  padding: 14px 22px 16px 22px;
  overflow: hidden;
  flex-grow: 1;
  flex-shrink: 1;
}

.camp-body > .btn,
.section > .btn,
.shard-row > .btn,
.ucell > .btn {
  align-self: flex-start;
}

.camp-body .t-p {
  margin: 0 0 10px 0;
}

.camp-body .t-h3 {
  margin: 16px 0 8px 0;
}

.camp-body .faint {
  opacity: 0.65;
  font-size: 16px;
}

.camp-body .tag {
  font-size: 14px;
  -unity-font-style: bold;
  color: #4f8f36;
  margin: 6px 0 0 0;
}

.coins-line {
  align-self: flex-start;
  margin-bottom: 12px;
  padding: 6px 18px 6px 12px;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #ffd76a;
  -unity-font-style: bold;
  font-size: 22px;
}

.section {
  margin-top: 18px;
  padding-top: 12px;
  border-top-width: 3px;
  border-top-color: rgba(42, 28, 20, 0.14);
}

.list {
  display: flex;
  flex-direction: column;
  margin: 8px 0 12px 0;
}

.list > * {
  margin-bottom: 2px;
}

.item-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 48px;
  padding: 7px 14px 7px 16px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.item-row > * {
  margin-right: 10px;
}

.item-row .right {
  margin-left: auto;
  -unity-font-style: bold;
  color: #b03e28;
}

.shard-row {
  padding: 11px 16px;
  margin-bottom: 4px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.shard-row .t-p {
  margin-bottom: 6px;
}

.upgrades {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}

.ucol {
  width: 49%;
  margin-bottom: 12px;
}

.ucol .t-h3 {
  margin: 0 0 6px 4px;
  font-size: 18px;
}

.ucell {
  padding: 11px 14px 12px 14px;
  margin-bottom: 2px;
  font-size: 16px;
  -unity-font-style: bold;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.ucell .t-p {
  margin: 3px 0 7px 0;
  font-size: 14px;
  -unity-font-style: normal;
}

.ucell.owned {
  opacity: 0.7;
}

/* a shop cell with a picture of what it sells: the picture on a sandy tile at the left, the rest beside it */
.ucell.pictured {
  flex-direction: row;
  align-items: flex-start;
}

.ucell-pic {
  width: 68px;
  height: 68px;
  flex-shrink: 0;
  margin: 2px 12px 0 0;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 244, 220, 0.75);
  border-width: 1px;
  border-color: rgba(150, 110, 60, 0.35);
  border-radius: 10px;
}

.ucell-text {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 0;
}

.ucell-text > .btn {
  align-self: flex-start;
}

/* the one in use: a coral frame */
.ucell.current {
  opacity: 1;
  background-image: resource("UI/Skin/row-on");
}

/* ---------- Lost & Found notes, photos ---------- */
.note {
  position: relative;
  padding: 12px 14px;
  margin-bottom: 12px;
  background-color: #fff3a8;
  border-radius: 4px;
  /* box-shadow: 2px 4px 10px rgba(60, 30, 10, 0.25); */
  rotate: -0.6deg;
}

/* Rewritten from .note:nth-child(even) — class .even added by CssAnimations.OnAttached / DOM layer */
.note.even,
.note.nth-even {
  background-color: #ffd0dc;
  rotate: 0.7deg;
}

.note.done {
  opacity: 0.5;
}

.note.has-photo {
  position: relative;
  padding-right: 118px;
  min-height: 112px;
}

.polaroid {
  position: absolute;
  top: 8px;
  right: 12px;
  width: 92px;
  padding: 6px 6px 4px 6px;
  background-color: #fdfbf4;
  /* box-shadow: 0 3px 8px rgba(50, 30, 10, 0.35); */
  /* transform: rotate(var(--tilt)); -> default -3deg, custom --tilt applied in CssAnimations.OnAttached */
  rotate: -3deg;
}

/* Rewritten from .polaroid::before (the pin) */
.polaroid-pin,
.polaroid > .before {
  position: absolute;
  top: -5px;
  left: 50%;
  width: 11px;
  height: 11px;
  margin-left: -5px;
  border-radius: 50%;
  /* background: radial-gradient(circle at 35% 30%, #ff8d7e, #c8362a 65%); */
  background-color: #d94b3e;
  /* box-shadow: 0 2px 3px rgba(0, 0, 0, 0.4); */
}

.polaroid .t-img {
  display: flex;
  width: 80px;
  height: 80px;
  /* width: 100%; aspect-ratio: 1; object-fit: cover; */
  -unity-background-scale-mode: scale-and-crop;
}

.polaroid .t-span {
  display: flex;
  margin-top: 3px;
  /* font: italic 10px/1.15 Georgia, serif; */
  -unity-font-style: italic;
  font-size: 11px;
  color: #4a3020;
  -unity-text-align: middle-center;
}

/* The camera's album (camp page "Photos") and its full-screen flash. Unity only: the browser build has no camera. */
.photo-flash {
  background-color: #ffffff;
}

.photo-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 6px;
}

.photo-card {
  width: 48%;
  margin-bottom: 12px;
  padding: 7px 7px 6px 7px;
  background-color: #fdfbf4;
  border-radius: 3px;
  border-width: 2px;
  border-color: #fdfbf4;
}

.photo-card.pinned {
  border-color: #d94b3e;
}

.photo-card .t-img {
  display: flex;
  width: 100%;
  height: 150px;
  -unity-background-scale-mode: scale-and-crop;
}

.photo-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 4px 0 14px 0;
  padding: 10px 10px 8px 10px;
  background-color: #fdfbf4;
  border-radius: 3px;
}

.photo-big .t-img {
  display: flex;
  width: 100%;
  height: 310px;
  -unity-background-scale-mode: scale-to-fit;
}

.photo-cap {
  display: flex;
  margin: 5px 0 6px 0;
  -unity-font-style: italic;
  font-size: 14px;
  color: #4a3020;
  -unity-text-align: middle-center;
}

.photo-btns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
}

.photo-btns .btn {
  margin: 2px 3px;
}

.photo-missing {
  height: 150px;
  font-size: 12px;
  color: #8a6f55;
  -unity-text-align: middle-center;
  background-color: #efe4cc;
}

/* ---------- saves ---------- */
.save-card {
  width: 680px;
  max-width: 94%;
}

.save-new {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 4px 0 12px 0;
}

.save-name {
  flex-grow: 1;
  flex-shrink: 1;
  height: 48px;
  margin: 0 8px 4px 0;
  padding: 10px 14px;
  border-radius: 12px;
  border-width: 3px;
  border-color: #2a1c14;
  background-color: #fffaf0;
  color: #2a1c14;
  font-size: 19px;
}

.save-name:focus {
  border-color: #e0a020;
  background-color: #ffffff;
}

.save-list {
  display: flex;
  flex-direction: column;
  max-height: 420px;
  flex-shrink: 1;
  overflow: hidden;
  margin: 4px 0 12px 0;
  -unity-text-align: middle-left;
}

.save-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
  padding: 10px 12px 10px 18px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.save-row .si {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex-shrink: 1;
  margin-right: 12px;
}

.save-row .si .t-b {
  font-size: 20px;
  -unity-text-align: middle-left;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-text-overflow-position: end;
  white-space: nowrap;
}

.save-row .si .t-span {
  font-size: 15px;
  opacity: 0.7;
  -unity-text-align: middle-left;
}

.save-row .sb {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.save-empty {
  margin: 18px 0;
  opacity: 0.65;
  -unity-text-align: middle-center;
}

.save-note {
  margin: 0 0 12px 0;
  font-size: 15px;
  opacity: 0.68;
  -unity-text-align: middle-center;
}

/* ---------- the big map ---------- */
.map-card {
  width: auto;
  max-width: 96%;
  padding: 0 30px 36px 30px;
}

.map-card > .t-h1 {
  font-size: 28px;
  margin-bottom: 10px;
}

.bigmap-canvas {
  display: flex;
  align-self: center;
  margin: 0 auto 10px auto;
  border-radius: 14px;
  border-width: 3px;
  border-color: #2a1c14;
}

.map-tabs {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin: 0 0 8px 0;
}

.map-tabs .btn.on {
  color: #ffffff;
  text-shadow: 0 2px 0 rgba(20, 70, 64, 0.8);
  background-image: resource("UI/Skin/btn-sm-teal");
}

.map-cursor {
  position: absolute;
  width: 30px;
  height: 30px;
  margin: -15px 0 0 -15px;
  border-width: 4px;
  border-color: #ffc84a;
  border-radius: 50%;
  background-color: rgba(42, 28, 20, 0.25);
}

.binoc {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* ---------- main menu ---------- */
.mainmenu {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 110px;
  /* fades in: CssAnimations .mainmenu */
}

/* darkens the left of the picture so the title and the list read against the sky and the sand */
.mm-scrim {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 66%;
  background-image: resource("UI/Skin/scrim-left");
}

.mm-panel {
  width: 680px;
  max-width: 90%;
  color: #fff6e4;
}

.mm-kicker {
  margin: 0 0 4px 6px;
  font-size: 17px;
  -unity-font-style: bold;
  letter-spacing: 6px;
  color: #ffd76a;
  text-shadow: 0 2px 0 rgba(20, 12, 8, 0.7);
}

.mm-title {
  margin: 0;
  font-size: 80px;
  -unity-font-style: normal;
  color: #fff3d6;
  text-shadow: 0 6px 0 #2a1c14;
  -unity-text-outline-width: 1px;
  -unity-text-outline-color: #2a1c14;
}

.mm-tag {
  margin: 14px 0 30px 6px;
  font-size: 21px;
  -unity-font-style: italic;
  opacity: 0.95;
  text-shadow: 0 2px 0 rgba(20, 12, 8, 0.6);
}

.mm-buttons {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

/* a line of the menu: plain words until it is chosen, then it slides out on a coral plate */
.mm-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 420px;
  height: 64px;
  margin: 0 0 1px -8px;
  padding: 0 30px 11px 22px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
  font-size: 31px;
  -unity-font-style: bold;
  color: #fff6e4;
  text-shadow: 0 3px 0 rgba(20, 12, 8, 0.8);
  transition-property: translate;
  transition-duration: 0.12s;
}

.mm-btn:focus {
  translate: 18px 0;
  color: #ffffff;
  text-shadow: 0 3px 0 rgba(120, 40, 24, 0.85);
  background-image: resource("UI/Skin/menu-plate");
  -unity-slice-left: 56;
  -unity-slice-top: 40;
  -unity-slice-right: 56;
  -unity-slice-bottom: 52;
  -unity-slice-scale: 0.5px;
}

.mm-btn:active {
  translate: 18px 2px;
}

.mm-btn.disabled,
.mm-btn.disabled:focus,
.mm-btn.disabled:active {
  opacity: 0.42;
  translate: 0 0;
}

.mm-mark {
  width: 28px;
  height: 28px;
  margin: 0 10px 0 4px;
  background-image: resource("UI/Skin/arrow-gold");
  opacity: 0;
}

.mm-btn:focus .mm-mark {
  opacity: 1;
}

.mm-foot {
  position: absolute;
  left: 116px;
  bottom: 34px;
  font-size: 15px;
  color: #fff6e4;
  opacity: 0.7;
  text-shadow: 0 1px 0 rgba(20, 12, 8, 0.7);
}

/* ---------- what the buttons do, along the bottom of every menu ---------- */
.padbar {
  position: absolute;
  right: 36px;
  bottom: 28px;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 7px 18px 7px 0;
  background-image: resource("UI/Skin/plate");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

/* the HUD's own bottom corners make way for it (UIManager.setMenuBar sets .menu-open on the body) */
.menu-open .tool-badge,
.menu-open .padtools,
.menu-open .scope,
.menu-open .pt-caption {
  display: none;
}

/* the camp fills the right of the screen, so its line moves to the left */
.padbar.left {
  right: auto;
  left: 36px;
}

.pb-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-left: 18px;
  color: #fbf2de;
  font-size: 18px;
  -unity-font-style: bold;
  white-space: nowrap;
}

.pb-item .kc {
  margin: 0 4px 0 0;
}

.pb-label {
  margin-left: 4px;
}

/* ---------- settings ---------- */
.settings-card {
  width: 820px;
  max-width: 94%;
  max-height: 92%;
  display: flex;
  flex-direction: column;
}

.set-rows {
  -unity-text-align: middle-left;
  margin: 0 0 10px 0;
  flex-shrink: 1;
  min-height: 120px;
  overflow: hidden;
}

.set-rows .t-h3 {
  margin: 10px 8px 2px 8px;
  font-size: 14px;
  letter-spacing: 3px;
  color: #b03e28;
  -unity-text-align: middle-left;
}

/* a setting is one row that is chosen whole; left and right change it */
.set-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 50px;
  margin: 0;
  padding: 7px 20px 7px 20px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  color: #2a1c14;
  font-size: 18px;
}

.set-row:focus {
  background-image: resource("UI/Skin/row-focus");
}

.set-name {
  display: flex;
  flex-direction: column;
  width: 330px;
  flex-shrink: 0;
  margin-right: 16px;
  -unity-text-align: middle-left;
}

.set-label {
  -unity-font-style: bold;
  -unity-text-align: middle-left;
}

.set-hint {
  font-size: 14px;
  opacity: 0.66;
  -unity-text-align: middle-left;
}

.set-val {
  width: 76px;
  flex-shrink: 0;
  font-size: 17px;
  -unity-font-style: bold;
  -unity-text-align: middle-right;
}

.set-range {
  flex-grow: 1;
  flex-shrink: 1;
}

/* sliders (HTMLInputElement, type range) */
.range {
  height: 32px;
  justify-content: center;
}

.range-track {
  position: relative;
  height: 24px;
  padding: 3px;
  background-image: resource("UI/Skin/bar");
  -unity-slice-left: 24;
  -unity-slice-right: 24;
  -unity-slice-scale: 0.5px;
}

.range-fill {
  height: 18px;
  background-image: resource("UI/Skin/bar-fill-teal");
  -unity-slice-left: 18;
  -unity-slice-right: 18;
  -unity-slice-scale: 0.5px;
}

.range-thumb {
  position: absolute;
  top: -3px;
  width: 30px;
  height: 30px;
  margin-left: -15px;
  background-image: resource("UI/Skin/knob");
}

/* an on / off switch */
.set-switch {
  width: 60px;
  height: 32px;
  margin-left: auto;
  flex-shrink: 0;
  background-image: resource("UI/Skin/toggle-off");
}

.set-row.on .set-switch {
  background-image: resource("UI/Skin/toggle-on");
}

/* a choice from a short list: arrows either side of it */
.set-step {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  flex-grow: 1;
}

.step-arrow {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  background-image: resource("UI/Skin/arrow-right");
}

.step-arrow.left {
  background-image: resource("UI/Skin/arrow-left");
}

.step-val {
  min-width: 250px;
  margin: 0 8px;
  -unity-font-style: bold;
  -unity-text-align: middle-center;
  white-space: nowrap;
}

/* the old drop-down list (HTMLSelectElement), kept for any plain select */
.set-select {
  flex-grow: 1;
  flex-shrink: 1;
  padding: 7px 10px;
  border-radius: 10px;
  border-width: 2px;
  border-color: #2a1c14;
  background-color: #fffaf0;
  color: #2a1c14;
}

.set-options {
  display: flex;
  flex-direction: column;
  margin: 2px 0 8px 162px;
}

.set-option {
  padding: 6px 12px;
  margin-bottom: 4px;
  border-width: 0;
  border-radius: 8px;
  background-color: rgba(42, 28, 20, 0.12);
  color: #2a1c14;
  -unity-text-align: middle-left;
}

.set-option:focus {
  background-color: #ffc84a;
}

.set-option.on {
  -unity-font-style: bold;
}

/* ---------- credits, the ending ---------- */
.credits .credit {
  -unity-font-style: italic;
  font-size: 19px;
  margin: 8px 0 18px 0;
  opacity: 0.9;
  -unity-text-align: middle-center;
}

.teaser {
  background-color: rgba(10, 12, 18, 0.86);
}

.teaser .intro-card {
  width: 720px;
}

.teaser .credit {
  -unity-font-style: italic;
  font-size: 19px;
  margin: 8px 0 18px 0;
  opacity: 0.9;
  -unity-text-align: middle-center;
}

.ending-stats {
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin: 10px 0 14px 0;
}

.ending-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 6px;
  padding: 10px 20px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
}

.ending-stat .t-b {
  font-size: 28px;
  margin: 0 0 2px 0;
  color: #b03e28;
}

.ending-stat .t-span {
  font-size: 15px;
  opacity: 0.75;
}

/* ---------- achievements ---------- */
.ach-card {
  width: 760px;
  max-width: 94%;
  max-height: 88%;
  display: flex;
  flex-direction: column;
}

.ach-progress {
  align-self: center;
  width: 360px;
  margin: 0 0 12px 0;
}

.ach-list {
  overflow: hidden;
  margin: 0 0 12px 0;
  display: flex;
  flex-direction: column;
  flex-shrink: 1;
  min-height: 120px;
  -unity-text-align: middle-left;
}

.ach-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
  padding: 10px 18px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  opacity: 0.6;
}

/* earned: warm gold */
.ach-row.done {
  opacity: 1;
  -unity-background-image-tint-color: #ffe7a0;
}

.ach-icon {
  font-size: 30px;
  width: 40px;
  margin-right: 14px;
  -unity-text-align: middle-center;
}

.ach-text {
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  flex-shrink: 1;
}

.ach-text .t-b {
  font-size: 19px;
  -unity-text-align: middle-left;
}

.ach-text .t-span {
  font-size: 16px;
  opacity: 0.8;
  -unity-text-align: middle-left;
}

/* ---------- help ---------- */
.help-card {
  width: 1040px;
  max-width: 95%;
  max-height: 88%;
  display: flex;
  flex-direction: column;
  -unity-text-align: middle-left;
}

.help-tabs {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  margin: 0 0 8px 0;
}

.help-tabs .tabs-wrap {
  flex-grow: 0;
  justify-content: center;
}

.help-body {
  overflow: hidden;
  padding-right: 8px;
  margin-bottom: 10px;
  min-height: 120px;
  flex-grow: 1;
  flex-shrink: 1;
}

.help-body .t-h3 {
  margin: 14px 0 6px 0;
  font-size: 20px;
  color: #b03e28;
  -unity-text-align: middle-left;
}

.help-p {
  margin: 6px 0;
  font-size: 18px;
  -unity-text-align: middle-left;
}

.help-list {
  margin: 4px 0 6px 0;
  padding-left: 20px;
  font-size: 18px;
  -unity-text-align: middle-left;
}

.help-list .t-li {
  margin: 4px 0;
  -unity-text-align: middle-left;
}

.help-body .keys {
  margin: 4px 0 8px 0;
}

/* ---------- the new-game introduction ---------- */
.intro .intro-card {
  width: 720px;
}

.intro-text {
  -unity-text-align: middle-left;
  margin: 0 0 14px 0;
}

.intro-text .t-p {
  margin: 0 0 10px 0;
  font-size: 18px;
  -unity-text-align: middle-left;
}

.intro-first {
  padding: 0;
  margin: 12px 0;
  display: flex;
  flex-direction: column;
}

.intro-first .t-li {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 2px;
  padding: 9px 16px;
  background-image: resource("UI/Skin/row");
  -unity-slice-left: 32;
  -unity-slice-top: 32;
  -unity-slice-right: 32;
  -unity-slice-bottom: 32;
  -unity-slice-scale: 0.5px;
  font-size: 18px;
  -unity-font-style: bold;
  -unity-text-align: middle-left;
}

.intro-first .t-li .t-span {
  font-size: 24px;
  width: 32px;
  margin-right: 12px;
  -unity-text-align: middle-center;
}

.intro-text .intro-hint {
  opacity: 0.7;
  -unity-font-style: italic;
  font-size: 16px;
  margin: 8px 0 0 0;
  -unity-text-align: middle-center;
}

/* ---------- the camp journal ---------- */
.bookview {
  /* z-index: 6; */
}

.book {
  /* width: min(900px, 96vw); -> 900px at 1920x1080 */
  width: 900px;
  max-width: 96%;
  padding: 22px 26px 16px 26px;
  border-radius: 18px;
  /* background: linear-gradient(135deg, #8a3b2e, #6b2a22); */
  background-color: #7a3328;
  border-width: 3px;
  border-color: rgba(214, 169, 74, 0.55);
  /* box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55), inset 0 0 0 3px rgba(214, 169, 74, 0.55); */
}

.book-spread {
  /* display: grid; grid-template-columns: 1fr 1fr; min-height: min(430px, 62vh); -> 430px at 1920x1080 */
  display: flex;
  flex-direction: row;
  min-height: 430px;
  background-color: #f4ead0;
  border-radius: 8px;
  /* box-shadow: inset 0 0 40px rgba(120, 80, 30, 0.25); */
  position: relative;
}

/* Rewritten from .book-spread::after (book spine crease) */
.book-page.left {
  border-right-width: 2px;
  border-right-color: rgba(80, 50, 20, 0.22);
}

.book-spread-crease,
.book-spread > .after {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 18px;
  margin-left: -9px;
  /* background: linear-gradient(90deg, transparent, rgba(80, 50, 20, 0.28), transparent); */
  background-color: rgba(80, 50, 20, 0.18);
  /* pointer-events: none; */
}

/* @media (max-width: 760px) {
  .book-spread { grid-template-columns: 1fr; }
  .book-spread::after { display: none; }
} -- dropped: desktop wide-screen variant kept */

.book-page {
  position: relative;
  width: 50%;
  flex-grow: 1;
  flex-shrink: 1;
  padding: 30px 34px 40px 34px;
  color: #3b2a1e;
  /* font-family: Georgia, 'Times New Roman', serif; */
  -unity-text-align: middle-left;
}

.book-page .t-h2 {
  margin: 6px 0 12px 0;
  font-size: 24px;
  /* line-height: 1.15; */
  -unity-text-align: middle-left;
}

.book-page .t-p {
  margin: 0;
  font-size: 17px;
  /* line-height: 1.55; */
  -unity-text-align: middle-left;
}

.bp-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* gap: 10px; */
  font-size: 13px;
  letter-spacing: 1.5px;
  /* text-transform: uppercase; */
  opacity: 0.75;
}

.bp-head > * {
  margin-right: 10px;
}

.bp-new {
  background-color: #d6561f;
  color: #ffffff;
  padding: 1px 8px;
  border-radius: 99px;
  font-size: 11px;
  letter-spacing: 1px;
  opacity: 1;
}

.bp-num {
  position: absolute;
  bottom: 14px;
  left: 0;
  right: 0;
  -unity-text-align: middle-center;
  font-size: 13px;
  opacity: 0.55;
}

.book-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  /* gap: 10px; */
  margin-top: 14px;
}

.book-nav > * {
  margin-left: 5px;
  margin-right: 5px;
}

.book-count {
  color: #f4ead0;
  font-size: 17px;
  opacity: 0.85;
}

.book-nav .btn.disabled {
  opacity: 0.35;
  /* cursor: default; */
}

.bp-todo {
  border-width: 1px;
  border-color: rgba(59, 42, 30, 0.45);
  padding: 0 7px;
  border-radius: 99px;
  font-size: 11px;
  letter-spacing: 1px;
  opacity: 0.8;
}

/* ---------- letters from the owners ---------- */
.mail {
  /* width: min(560px, 94vw); -> 560px at 1920x1080 */
  width: 560px;
  max-width: 94%;
  padding: 20px 22px 14px 22px;
  border-radius: 16px;
  /* background: linear-gradient(135deg, #3b6ea5, #2f5a88); */
  background-color: #356497;
  border-width: 3px;
  border-color: rgba(255, 255, 255, 0.35);
  /* box-shadow: 0 18px 60px rgba(0, 0, 0, 0.5), inset 0 0 0 3px rgba(255, 255, 255, 0.35); */
}

.mail-sheet {
  /* min-height: min(380px, 56vh); -> 380px at 1920x1080 */
  min-height: 380px;
  padding: 26px 32px 28px 32px;
  border-radius: 6px;
  color: #3b2a1e;
  -unity-text-align: middle-left;
  /* background: repeating-linear-gradient(transparent 0 31px, rgba(80, 120, 160, 0.22) 31px 32px), #fbf5e2; */
  background-color: #fbf5e2;
  /* box-shadow: inset 0 0 30px rgba(120, 80, 30, 0.18); */
  /* font-family: 'Segoe Script', 'Bradley Hand', 'Comic Sans MS', cursive; */
}

.mail-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  /* gap: 10px; */
  font-size: 14px;
  opacity: 0.8;
}

.mail-head > * {
  margin-right: 10px;
}

.mail-from {
  -unity-font-style: bold;
}

.mail-stamp {
  margin-left: auto;
  font-size: 22px;
  padding: 2px 8px;
  border-width: 2px;
  border-color: rgba(180, 70, 40, 0.6);
  border-radius: 4px;
  color: #b44628;
}

.mail-greeting {
  margin: 14px 0 6px 0;
  font-size: 18px;
  -unity-text-align: middle-left;
}

.mail-body {
  margin: 0;
  font-size: 16px;
  /* line-height: 32px; */
  -unity-text-align: middle-left;
}

.mail-sign {
  margin: 12px 0 0 0;
  font-size: 17px;
  -unity-text-align: middle-right;
}

.mail-empty {
  margin: 60px 10px;
  -unity-text-align: middle-center;
  font-size: 17px;
  /* line-height: 1.6; */
  opacity: 0.8;
}

/* ---------- sleeping in the hammock ---------- */
.sleepveil {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* pointer-events: none; -> DOM layer sets pickingMode = Ignore */
  /* background: radial-gradient(ellipse at center, rgba(10, 14, 30, 0) 35%, rgba(10, 14, 30, 0.55) 100%); */
  background-color: rgba(10, 14, 30, 0.42);
  /* animation: sleepIn 1.2s ease both; -> driven by CssAnimations.cs */
  /* z-index: 3; */
}

.sleepmsg {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 12%;
  -unity-text-align: middle-center;
  color: #fff6e4;
  font-size: 18px;
  letter-spacing: 1px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
}

.zz {
  position: absolute;
  left: 52%;
  bottom: 30%;
  color: #fff6e4;
  -unity-font-style: bold;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  opacity: 0;
  /* animation: zzUp 3.6s ease-in-out infinite; -> driven by CssAnimations.cs */
}

.zz1 {
  /* animation-delay: 1.2s; -> handled in CssAnimations.cs */
  margin-left: 24px;
}

.zz2 {
  /* animation-delay: 2.4s; -> handled in CssAnimations.cs */
  margin-left: 48px;
}

/* ---------- diving ---------- */
.dive-tint {
  /* position: fixed; inset: 0; */
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  /* pointer-events: none; -> DOM layer sets pickingMode = Ignore */
  opacity: 0;
  transition-property: opacity;
  transition-duration: 0.6s;
  /* background: radial-gradient(ellipse at center, rgba(40, 150, 190, 0) 45%, rgba(10, 70, 110, 0.4) 100%); */
  background-color: rgba(15, 85, 125, 0.24);
}

.dive-tint.on {
  opacity: 1;
}

.t-body.diving .minimap,
.diving .minimap,
.diving .minimap-ring {
  display: none;
}

.t-body.underground .minimap,
.underground .minimap,
.underground .minimap-ring {
  display: none;
}

/* ---------- labels inside the page's nowrap rules (see ".t-html .unity-label" near the top) ---------- */
.t-html .prompt .unity-label,
.t-html .chip .unity-label,
.t-html .hint .unity-label,
.t-html .btn .unity-label,
.t-html .mm-btn .unity-label,
.t-html .kc .unity-label,
.t-html .pb-item .unity-label,
.t-html .step-val .unity-label,
.t-html .card .cat .unity-label,
.t-html .camp-head .t-h2 .unity-label,
.t-html .intro-card > .t-h1 .unity-label,
.t-html .krow .t-b .unity-label {
  white-space: nowrap;
}

.t-html .save-row .si .t-b .unity-label {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  -unity-text-overflow-position: end;
}

/* ---------- scrollbars ----------
   A slim rounded thumb in the page's ink colour on a faint track, with no arrow buttons, instead of Unity's grey default. */
.t-html .unity-scroll-view .unity-scroller--vertical {
  width: 12px;
  min-width: 12px;
  margin-left: 4px;
  border-width: 0;
  background-color: rgba(0, 0, 0, 0);
}

.t-html .unity-scroll-view .unity-scroller--horizontal {
  display: none;
}

.t-html .unity-scroll-view .unity-scroller .unity-scroller__low-button,
.t-html .unity-scroll-view .unity-scroller .unity-scroller__high-button {
  display: none;
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-scroller__slider {
  margin: 0;
  padding: 0;
  flex-grow: 1;
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__input {
  margin: 0;
  padding: 0;
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
  left: 2px;
  right: 2px;
  width: auto;
  margin: 0;
  border-width: 0;
  border-radius: 4px;
  background-color: rgba(42, 28, 20, 0.1);
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger-border {
  display: none;
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
  left: 1px;
  width: 10px;
  margin: 0;
  border-width: 0;
  border-radius: 5px;
  background-color: rgba(42, 28, 20, 0.42);
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger:hover {
  background-color: rgba(42, 28, 20, 0.6);
}

.t-html .unity-scroll-view .unity-scroller--vertical .unity-base-slider__dragger:active {
  background-color: #ea6a47;
}
